# Deny direct web access to the vendored PDF library.
# The files are only ever loaded via require_once from PHP code, never requested
# directly by a browser, so blocking HTTP access is safe and prevents the library
# and its font metrics from being probed or executed as a standalone script.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
